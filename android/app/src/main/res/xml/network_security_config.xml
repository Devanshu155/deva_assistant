<?xml version="1.0" encoding="utf-8"?>
<!-- Only allow HTTPS traffic. Groq API is HTTPS so this is safe. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
